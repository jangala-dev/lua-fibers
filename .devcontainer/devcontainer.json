{
  "name": "fibers",
  "image": "debian:trixie-slim",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sudo /bin/sh '${containerWorkspaceFolder}/.devcontainer/bootstrap.sh'"
}
